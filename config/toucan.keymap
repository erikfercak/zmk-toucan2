#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <5>;
        };
    };

    behaviors {
        lhm: lhm {
            compatible = "zmk,behavior-hold-tap";
            label = "LHM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <36 37 38 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 38 39 40 41>;
        };

        rhm: rhm {
            compatible = "zmk,behavior-hold-tap";
            label = "RHM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <41 40 39 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        kp_hold_caps_word: kp_hold_caps_word {
            compatible = "zmk,behavior-hold-tap";
            label = "KP_HOLD_CAPS_WORD";
            bindings = <&kp>, <&caps_word>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp ESC    &kp Q            &kp W                &kp E            &kp R              &kp T                                  &kp Y  &kp U               &kp I             &kp O                 &kp P                     &kp BSPC
&kp TAB    &lhm LEFT_ALT A  &lhm LEFT_CONTROL S  &lhm LEFT_GUI D  &lhm LEFT_SHIFT F  &kp G                                  &kp H  &rhm RIGHT_SHIFT J  &rhm RIGHT_GUI K  &rhm RIGHT_CONTROL L  &rhm RIGHT_ALT SEMICOLON  &kp SQT
&kp GRAVE  &kp Z            &kp X                &kp C            &kp V              &kp B                                  &kp N  &kp M               &kp COMMA         &kp DOT               &kp FSLH                  &kp MINUS
                                                 &lt 3 LEFT       &lt 1 ENTER        &kp_hold_caps_word LS(LA(LC(LGUI))) 0  &none  &lt 2 SPACE         &kp RIGHT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&trans   &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6          &kp N7               &kp N8           &kp N9          &kp N0   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &rhm HOME LEFT  &rhm PAGE_DOWN DOWN  &rhm PAGE_UP UP  &rhm END RIGHT  &trans   &trans
&kp F11  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6          &kp F7               &kp F8           &kp F9          &kp F10  &kp F12
                         &trans  &trans  &trans  &trans          &trans               &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&kp TILDE  &kp EXCL            &kp AT                       &kp HASH                  &kp DLLR                          &kp PRCNT         &kp CARET          &kp AMPS                            &kp STAR                    &kp LPAR                         &kp RPAR                  &trans
&trans     &lhm LEFT_ALT PIPE  &lhm LEFT_CONTROL LESS_THAN  &lhm LEFT_GUI LEFT_BRACE  &lhm LEFT_SHIFT LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &rhm RIGHT_SHIFT RIGHT_PARENTHESIS  &rhm RIGHT_GUI RIGHT_BRACE  &rhm RIGHT_CONTROL GREATER_THAN  &rhm RIGHT_ALT BACKSLASH  &none
&kp GRAVE  &none               &kp LG(X)                    &kp LG(C)                 &kp LG(V)                         &kp MINUS         &kp EQUAL          &kp PLUS                            &none                       &none                            &kp SLASH                 &kp UNDER
                                                            &trans                    &trans                            &trans            &trans             &trans                              &trans
            >;
        };

        Numpad {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp KP_ASTERISK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp KP_DIVIDE    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp KP_EQUAL     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT    &kp UNDER
                        &trans  &trans  &trans  &trans           &trans           &kp KP_NUMBER_0
            >;

            label = "NUM";
        };

        mouse {
            display-name = "MOU";
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans     &trans     &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans     &trans     &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans     &trans     &trans     &trans     &trans  &trans  &trans
                        &mkp MCLK  &mkp LCLK  &mkp RCLK  &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        system {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &bt BT_CLR  &trans
&trans  &trans          &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans      &trans
&trans  &studio_unlock  &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans      &trans
                                      &none         &none         &none         &none   &none   &none
            >;

            label = "SYS";
        };
    };
};
